# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://atlanticsource:atlanticsource_secret@localhost:5432/atlanticsource_db?schema=public

# Authentication (Auth.js)
NEXTAUTH_SECRET=super_secret_nextauth_token_change_in_production_32chars
NEXTAUTH_URL=http://localhost:3000

# Object Storage (S3 / MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=atlanticsource-uploads
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Transactional Email (Resend / SMTP / Development)
EMAIL_PROVIDER=development
RESEND_API_KEY=re_123456789
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@atlanticsource.ca

# Development Smoke-Test Recipient Overrides
SMOKE_TEST_SUPPLIER_EMAIL_1=your-email-1@domain.com
SMOKE_TEST_SUPPLIER_EMAIL_2=your-email-2@domain.com

# Security & Rate Limiting
LOG_LEVEL=info

# Crawler: publish low-risk crawled facts without admin review ("true" or "false")
AUTO_PUBLISH_LOW_RISK_FACTS=false

