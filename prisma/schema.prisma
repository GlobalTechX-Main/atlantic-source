generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRoleEnum {
  PLATFORM_ADMIN
  BUYER_ADMIN
  BUYER_MEMBER
  SUPPLIER_ADMIN
  SUPPLIER_MEMBER
  USER
}

enum ClaimStatusEnum {
  UNCLAIMED
  CLAIM_PENDING
  VERIFIED
}

enum VerificationStatusEnum {
  UNVERIFIED
  VERIFIED
}

enum ProfileStatusEnum {
  DRAFT
  PUBLISHED
  NEEDS_REVISION
  ARCHIVED
}

enum LocationTypeEnum {
  HEADQUARTERS
  BRANCH
  PLANT
  WAREHOUSE
  OFFICE
}

enum RegionTypeEnum {
  CITY
  PROVINCE
  REGION
}

enum ProvenanceTypeEnum {
  PUBLICLY_DISCOVERED
  SUPPLIER_PROVIDED
  VERIFIED
}

enum VerificationStateEnum {
  UNREVIEWED
  PENDING
  VERIFIED
  APPROVED
  REJECTED
  AUTO_APPROVED
  AUTO_REJECTED
  HUMAN_REVIEW
  HUMAN_APPROVED
  HUMAN_REJECTED
}

enum ContactTypeEnum {
  GENERAL
  SALES
  ESTIMATING
  PROCUREMENT
  SUPPORT
  INDIVIDUAL_BUSINESS_CONTACT
  OTHER
}

enum CrawlStatusEnum {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum SourceTypeEnum {
  HTML
  PDF
  TEXT
}

enum ExtractionMethodEnum {
  JSON_LD
  META
  CONTACT_PARSER
  ADDRESS_PARSER
  TAXONOMY_EXACT
  TAXONOMY_ALIAS
  TAXONOMY_PHRASE
  PAGE_STRUCTURE
}

enum ClaimVerificationMethodEnum {
  EMAIL_DOMAIN
  DOCUMENT_PROOF
}

enum SourcingRequestStatusEnum {
  DRAFT
  SENT
  CLOSED
  CANCELLED
}

enum RequirementTypeEnum {
  REQUIRED
  PREFERRED
}

enum RFQDeliveryStatusEnum {
  PENDING
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
  NO_CONTACT
}

enum RFQResponseStatusEnum {
  PENDING
  INTERESTED
  NEED_INFORMATION
  DECLINED
  QUOTE_SUBMITTED
}

enum SenderTypeEnum {
  BUYER
  SUPPLIER
}

enum AttachmentOwnerTypeEnum {
  RFQ
  RFQ_RESPONSE
  CLAIM_PROOF
}

enum AttachmentUploadStatusEnum {
  PENDING
  COMPLETED
  FAILED
}

enum EmailStateEnum {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

enum ReportTypeEnum {
  OUTDATED_COMPANY
  WRONG_CONTACT
  WRONG_CAPABILITY
  COMPANY_CLOSED
  INACCURATE_INFORMATION
}

enum ReportStatusEnum {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

// -----------------------------------------------------------------------------
// USER & IDENTITY (Auth.js Compatible)
// -----------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  normalizedEmail String    @unique
  name            String?
  emailVerifiedAt DateTime?
  image           String?
  isPlatformAdmin Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  buyerMemberships       BuyerMembership[]
  supplierMemberships    SupplierMembership[]
  createdRFQs            SourcingRequest[]      @relation("CreatedRFQs")
  reviewedClaims         ExtractedClaim[]       @relation("ReviewedClaims")
  submittedClaimRequests CompanyClaimRequest[]  @relation("ClaimantUser")
  reviewedClaimRequests  CompanyClaimRequest[]  @relation("ClaimReviewer")
  reviewedReports        SupplierReport[]       @relation("ReportReviewer")
  auditLogs              AuditLog[]
  rfqMessages            RFQMessage[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -----------------------------------------------------------------------------
// BUYER ORGANIZATIONS & MEMBERSHIP
// -----------------------------------------------------------------------------

model BuyerOrganization {
  id               String   @id @default(cuid())
  name             String
  website          String?
  normalizedDomain String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships      BuyerMembership[]
  sourcingRequests SourcingRequest[]

  @@map("buyer_organizations")
}

model BuyerMembership {
  id                  String       @id @default(cuid())
  buyerOrganizationId String
  userId              String
  role                UserRoleEnum @default(BUYER_MEMBER)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  buyerOrganization BuyerOrganization @relation(fields: [buyerOrganizationId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([buyerOrganizationId, userId])
  @@map("buyer_memberships")
}

// -----------------------------------------------------------------------------
// SUPPLIER COMPANY & MEMBERSHIP
// -----------------------------------------------------------------------------

model SupplierCompany {
  id                 String                 @id @default(cuid())
  canonicalName      String
  legalName          String?
  slug               String                 @unique
  description        String?                @db.Text
  websiteUrl         String?
  normalizedDomain   String?
  yearFounded        Int?
  claimStatus        ClaimStatusEnum        @default(UNCLAIMED)
  verificationStatus VerificationStatusEnum @default(UNVERIFIED)
  profileStatus      ProfileStatusEnum      @default(DRAFT)
  publishedAt        DateTime?
  lastReviewedAt     DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  memberships           SupplierMembership[]
  locations             SupplierLocation[]
  serviceRegions        SupplierServiceRegion[]
  capabilities          SupplierCapability[]
  industries            SupplierIndustry[]
  certifications        SupplierCertification[]
  equipments            SupplierEquipment[]
  contacts              Contact[]
  crawlRuns             CrawlRun[]
  sourceDocuments       SourceDocument[]
  extractedClaims       ExtractedClaim[]
  claimRequests         CompanyClaimRequest[]
  reports               SupplierReport[]
  rfqRecipients         RFQRecipient[]

  @@map("supplier_companies")
}

model SupplierMembership {
  id                String       @id @default(cuid())
  supplierCompanyId String
  userId            String
  role              UserRoleEnum @default(SUPPLIER_MEMBER)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  supplierCompany SupplierCompany @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([supplierCompanyId, userId])
  @@map("supplier_memberships")
}

// -----------------------------------------------------------------------------
// LOCATIONS & SERVICE REGIONS
// -----------------------------------------------------------------------------

model SupplierLocation {
  id                String                @id @default(cuid())
  supplierCompanyId String
  locationType      LocationTypeEnum      @default(HEADQUARTERS)
  addressLine1      String
  addressLine2      String?
  city              String
  province          String                @default("NB")
  postalCode        String?
  country           String                @default("Canada")
  latitude          Float?
  longitude         Float?
  provenance        ProvenanceTypeEnum    @default(PUBLICLY_DISCOVERED)
  verificationState VerificationStateEnum @default(UNREVIEWED)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  supplierCompany SupplierCompany @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)

  @@map("supplier_locations")
}

model ServiceRegion {
  id         String         @id @default(cuid())
  name       String
  slug       String         @unique
  regionType RegionTypeEnum @default(CITY)
  parentId   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  parent         ServiceRegion?          @relation("RegionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       ServiceRegion[]         @relation("RegionHierarchy")
  supplierCoverages SupplierServiceRegion[]

  @@map("service_regions")
}

model SupplierServiceRegion {
  id                String                @id @default(cuid())
  supplierCompanyId String
  serviceRegionId   String
  provenanceType    ProvenanceTypeEnum    @default(PUBLICLY_DISCOVERED)
  verificationState VerificationStateEnum @default(UNREVIEWED)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  supplierCompany SupplierCompany @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  serviceRegion   ServiceRegion   @relation(fields: [serviceRegionId], references: [id], onDelete: Cascade)

  @@unique([supplierCompanyId, serviceRegionId])
  @@map("supplier_service_regions")
}

// -----------------------------------------------------------------------------
// TAXONOMIES (CAPABILITIES, INDUSTRIES, CERTIFICATIONS, EQUIPMENT)
// -----------------------------------------------------------------------------

model Capability {
  id            String   @id @default(cuid())
  canonicalName String
  slug          String   @unique
  description   String?  @db.Text
  parentId      String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent                Capability?                @relation("CapabilityHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children              Capability[]               @relation("CapabilityHierarchy")
  aliases               CapabilityAlias[]
  supplierCapabilities  SupplierCapability[]
  rfqRequirements       RFQCapabilityRequirement[]

  @@map("capabilities")
}

model CapabilityAlias {
  id              String   @id @default(cuid())
  alias           String
  capabilityId    String
  normalizedAlias String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@map("capability_aliases")
}

model SupplierCapability {
  id                String                @id @default(cuid())
  supplierCompanyId String
  capabilityId      String
  provenanceType    ProvenanceTypeEnum    @default(PUBLICLY_DISCOVERED)
  extractedClaimId  String?
  verificationState VerificationStateEnum @default(UNREVIEWED)
  published         Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  supplierCompany SupplierCompany @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  capability      Capability      @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  extractedClaim  ExtractedClaim? @relation(fields: [extractedClaimId], references: [id], onDelete: SetNull)

  @@unique([supplierCompanyId, capabilityId])
  @@map("supplier_capabilities")
}

model Industry {
  id            String   @id @default(cuid())
  canonicalName String
  slug          String   @unique
  description   String?  @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aliases            IndustryAlias[]
  supplierIndustries SupplierIndustry[]
  rfqPreferences     RFQIndustryPreference[]

  @@map("industries")
}

model IndustryAlias {
  id              String   @id @default(cuid())
  alias           String
  industryId      String
  normalizedAlias String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  industry Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@map("industry_aliases")
}

model SupplierIndustry {
  id                String                @id @default(cuid())
  supplierCompanyId String
  industryId        String
  provenanceType    ProvenanceTypeEnum    @default(PUBLICLY_DISCOVERED)
  extractedClaimId  String?
  verificationState VerificationStateEnum @default(UNREVIEWED)
  published         Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  supplierCompany SupplierCompany @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  industry        Industry        @relation(fields: [industryId], references: [id], onDelete: Cascade)
  extractedClaim  ExtractedClaim? @relation(fields: [extractedClaimId], references: [id], onDelete: SetNull)

  @@unique([supplierCompanyId, industryId])
  @@map("supplier_industries")
}

model Certification {
  id            String   @id @default(cuid())
  canonicalName String
  slug          String   @unique
  issuingBody   String?
  website       String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplierCertifications SupplierCertification[]
  rfqRequirements        RFQCertificationRequirement[]

  @@map("certifications")
}

model SupplierCertification {
  id                String                @id @default(cuid())
  supplierCompanyId String
  certificationId   String
  certificateNumber String?
  expiresAt         DateTime?
  provenanceType    ProvenanceTypeEnum    @default(PUBLICLY_DISCOVERED)
  extractedClaimId  String?
  verificationState VerificationStateEnum @default(UNREVIEWED)
  published         Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  supplierCompany SupplierCompany @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  certification   Certification   @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  extractedClaim  ExtractedClaim? @relation(fields: [extractedClaimId], references: [id], onDelete: SetNull)

  @@unique([supplierCompanyId, certificationId])
  @@map("supplier_certifications")
}

model EquipmentType {
  id            String   @id @default(cuid())
  canonicalName String
  slug          String   @unique
  description   String?  @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplierEquipments SupplierEquipment[]

  @@map("equipment_types")
}

model SupplierEquipment {
  id                String                @id @default(cuid())
  supplierCompanyId String
  equipmentTypeId   String
  quantity          Int                   @default(1)
  modelInfo         String?
  provenanceType    ProvenanceTypeEnum    @default(PUBLICLY_DISCOVERED)
  extractedClaimId  String?
  verificationState VerificationStateEnum @default(UNREVIEWED)
  published         Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  supplierCompany SupplierCompany @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  equipmentType   EquipmentType   @relation(fields: [equipmentTypeId], references: [id], onDelete: Cascade)
  extractedClaim  ExtractedClaim? @relation(fields: [extractedClaimId], references: [id], onDelete: SetNull)

  @@map("supplier_equipments")
}

// -----------------------------------------------------------------------------
// CONTACTS
// -----------------------------------------------------------------------------

model Contact {
  id                  String                @id @default(cuid())
  supplierCompanyId   String
  name                String?
  title               String?
  publicBusinessEmail String?
  normalizedEmail     String?
  publicBusinessPhone String?
  contactType         ContactTypeEnum       @default(GENERAL)
  sourceDocumentId    String?
  provenanceType      ProvenanceTypeEnum   @default(PUBLICLY_DISCOVERED)
  verificationState   VerificationStateEnum @default(UNREVIEWED)
  lastVerifiedAt      DateTime?
  bouncedAt           DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  supplierCompany SupplierCompany @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  sourceDocument  SourceDocument?  @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  rfqRecipients   RFQRecipient[]
  emailDeliveries EmailDelivery[]

  @@map("contacts")
}

// -----------------------------------------------------------------------------
// CRAWLING & PROVENANCE (No raw HTML binaries in DB)
// -----------------------------------------------------------------------------

model CrawlRun {
  id              String          @id @default(cuid())
  supplierCompanyId String
  seedUrl         String
  status          CrawlStatusEnum @default(PENDING)
  attempts        Int             @default(0)
  pagesDiscovered Int             @default(0)
  pagesFetched    Int             @default(0)
  pagesRejected   Int             @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  errorSummary    String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  supplierCompany SupplierCompany  @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  sourceDocuments SourceDocument[]

  @@map("crawl_runs")
}

model SourceDocument {
  id              String         @id @default(cuid())
  supplierCompanyId String
  crawlRunId      String
  sourceUrl       String
  canonicalUrl    String
  sourceType      SourceTypeEnum @default(HTML)
  pageType        String?
  title           String?
  fetchedAt       DateTime       @default(now())
  httpStatus      Int
  mimeType        String
  contentHash     String         // SHA-256
  extractedText   String         @db.Text
  structuredData  String?        @db.Text // JSON string metadata
  freshnessStatus String         @default("FRESH")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  supplierCompany SupplierCompany  @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  crawlRun        CrawlRun         @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  extractionRuns  ExtractionRun[]
  extractedClaims ExtractedClaim[]
  contacts        Contact[]

  @@map("source_documents")
}

model ExtractionRun {
  id               String          @id @default(cuid())
  sourceDocumentId String
  extractorVersion String
  status           CrawlStatusEnum @default(PENDING)
  claimsGenerated  Int             @default(0)
  errors           String?         @db.Text
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  sourceDocument SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  @@map("extraction_runs")
}

model ExtractedClaim {
  id                      String               @id @default(cuid())
  supplierCompanyId       String
  sourceDocumentId        String
  claimType               String               // e.g. "CAPABILITY", "LOCATION", "CERTIFICATION"
  rawValue                String
  normalizedValue         String?
  evidenceText            String               @db.Text
  evidenceLocator         String?              // CSS selector or XPath
  extractionMethod        ExtractionMethodEnum @default(TAXONOMY_EXACT)
  confidence              Float                @default(1.0)
  reviewState             VerificationStateEnum @default(UNREVIEWED)
  validationDecision      String?
  validationRisk          String?
  validationReason        String?              @db.Text
  validationConfidence    Float?
  validationActor         String?
  reviewedByUserId        String?
  reviewedAt              DateTime?
  publishedEntityReference String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  supplierCompany      SupplierCompany         @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  sourceDocument       SourceDocument          @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  reviewedByUser       User?                   @relation("ReviewedClaims", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  supplierCapabilities SupplierCapability[]
  supplierIndustries   SupplierIndustry[]
  supplierCertifications SupplierCertification[]
  supplierEquipments   SupplierEquipment[]

  @@map("extracted_claims")
}

// -----------------------------------------------------------------------------
// COMPANY CLAIMING
// -----------------------------------------------------------------------------

model CompanyClaimRequest {
  id                String                      @id @default(cuid())
  supplierCompanyId String
  requestingUserId  String
  requestedDomain   String?
  verificationMethod ClaimVerificationMethodEnum
  status            VerificationStateEnum       @default(PENDING)
  evidence          String?                     @db.Text
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  supplierCompany SupplierCompany @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  requestingUser  User            @relation("ClaimantUser", fields: [requestingUserId], references: [id], onDelete: Cascade)
  reviewedByUser  User?           @relation("ClaimReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@map("company_claim_requests")
}

model ClaimVerificationToken {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  claimRequestId    String
  requestingUserId  String
  supplierCompanyId String
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  @@map("claim_verification_tokens")
}

model SupplierReport {
  id                String           @id @default(cuid())
  supplierCompanyId String
  reporterEmail     String
  reporterName      String?
  reportType        ReportTypeEnum
  details           String           @db.Text
  status            ReportStatusEnum @default(PENDING)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  supplierCompany SupplierCompany @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  reviewedByUser  User?           @relation("ReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@map("supplier_reports")
}

// -----------------------------------------------------------------------------
// SOURCING REQUESTS (RFQ) & SUPPLIER OUTREACH
// -----------------------------------------------------------------------------

model SourcingRequest {
  id                  String                    @id @default(cuid())
  buyerOrganizationId String
  creatorUserId       String
  title               String
  description         String                    @db.Text
  city                String?
  province            String?                   @default("NB")
  responseDeadline    DateTime?
  quantity            String?
  budget              Decimal?                  @db.Decimal(12, 2)
  notes               String?                   @db.Text
  status              SourcingRequestStatusEnum @default(DRAFT)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  buyerOrganization BuyerOrganization              @relation(fields: [buyerOrganizationId], references: [id], onDelete: Cascade)
  creatorUser       User                           @relation("CreatedRFQs", fields: [creatorUserId], references: [id], onDelete: Cascade)
  recipients        RFQRecipient[]
  messages          RFQMessage[]
  requiredCapabilities RFQCapabilityRequirement[]
  requiredCertifications RFQCertificationRequirement[]
  preferredIndustries RFQIndustryPreference[]

  @@map("sourcing_requests")
}

model RFQCapabilityRequirement {
  id                String               @id @default(cuid())
  sourcingRequestId String
  capabilityId      String
  requirementType   RequirementTypeEnum @default(REQUIRED)
  createdAt         DateTime             @default(now())

  sourcingRequest SourcingRequest @relation(fields: [sourcingRequestId], references: [id], onDelete: Cascade)
  capability      Capability      @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([sourcingRequestId, capabilityId])
  @@map("rfq_capability_requirements")
}

model RFQCertificationRequirement {
  id                String               @id @default(cuid())
  sourcingRequestId String
  certificationId   String
  requirementType   RequirementTypeEnum @default(REQUIRED)
  createdAt         DateTime             @default(now())

  sourcingRequest SourcingRequest @relation(fields: [sourcingRequestId], references: [id], onDelete: Cascade)
  certification   Certification   @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@unique([sourcingRequestId, certificationId])
  @@map("rfq_certification_requirements")
}

model RFQIndustryPreference {
  id                String   @id @default(cuid())
  sourcingRequestId String
  industryId        String
  createdAt         DateTime @default(now())

  sourcingRequest SourcingRequest @relation(fields: [sourcingRequestId], references: [id], onDelete: Cascade)
  industry        Industry        @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@unique([sourcingRequestId, industryId])
  @@map("rfq_industry_preferences")
}

model RFQRecipient {
  id                String                @id @default(cuid())
  sourcingRequestId String
  supplierCompanyId String
  selectedContactId String?
  deliveryStatus    RFQDeliveryStatusEnum @default(PENDING)
  sentAt            DateTime?
  bouncedAt         DateTime?
  responseStatus    RFQResponseStatusEnum @default(PENDING)
  respondedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  sourcingRequest SourcingRequest @relation(fields: [sourcingRequestId], references: [id], onDelete: Cascade)
  supplierCompany SupplierCompany @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  selectedContact Contact?         @relation(fields: [selectedContactId], references: [id], onDelete: SetNull)
  response        RFQResponse?
  messages        RFQMessage[]

  @@unique([sourcingRequestId, supplierCompanyId])
  @@map("rfq_recipients")
}

model RFQResponse {
  id              String                @id @default(cuid())
  recipientId     String                @unique
  status          RFQResponseStatusEnum @default(INTERESTED)
  message         String?               @db.Text
  indicativeQuote Decimal?              @db.Decimal(12, 2)
  currency        String                @default("CAD")
  leadTime        String?
  declineReason   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  recipient RFQRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("rfq_responses")
}

model RFQMessage {
  id                String         @id @default(cuid())
  sourcingRequestId String
  recipientId       String
  senderUserId      String?
  senderType        SenderTypeEnum
  message           String         @db.Text
  createdAt         DateTime       @default(now())

  sourcingRequest SourcingRequest @relation(fields: [sourcingRequestId], references: [id], onDelete: Cascade)
  recipient       RFQRecipient    @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  senderUser      User?           @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@map("rfq_messages")
}

// -----------------------------------------------------------------------------
// ATTACHMENTS (Metadata only, binaries in S3)
// -----------------------------------------------------------------------------

model Attachment {
  id           String                     @id @default(cuid())
  ownerType    AttachmentOwnerTypeEnum
  ownerId      String
  objectKey    String
  fileName     String
  mimeType     String
  sizeBytes    Int
  checksum     String?
  uploadStatus AttachmentUploadStatusEnum @default(PENDING)
  createdAt    DateTime                   @default(now())

  @@map("attachments")
}

// -----------------------------------------------------------------------------
// EMAIL DELIVERY (No secrets or tokens)
// -----------------------------------------------------------------------------

model EmailDelivery {
  id                 String         @id @default(cuid())
  providerMessageId  String?
  recipientContactId String?
  recipientEmail     String
  messageType        String
  state              EmailStateEnum @default(QUEUED)
  queuedAt           DateTime       @default(now())
  sentAt             DateTime?
  deliveredAt        DateTime?
  bouncedAt          DateTime?
  failedAt           DateTime?
  metadata           String?        @db.Text

  recipientContact Contact? @relation(fields: [recipientContactId], references: [id], onDelete: SetNull)

  @@map("email_deliveries")
}

// -----------------------------------------------------------------------------
// AUDIT LOG
// -----------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String   // e.g. "CLAIM_APPROVED", "SUPPLIER_EDITED", "RFQ_SENT"
  targetType  String   // e.g. "SupplierCompany", "SourcingRequest"
  targetId    String
  metadata    String?  @db.Text // Safe metadata JSON diff
  createdAt   DateTime @default(now())

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
